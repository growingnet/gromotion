# Copy to .env and adjust. Read by the backend directly, and by docker compose.

# The hosted cluster the app normally reads. Use a READ-ONLY database user:
# the server only ever reads, and ingest is given a separate read-write user
# on the command line so the write credential never lives in this file.
MONGO_URI=mongodb+srv://app_readonly:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Working offline instead:
#   docker compose --profile local-db up -d   ->  MONGO_URI=mongodb://mongo:27017
#   mongod on the host                        ->  MONGO_URI=mongodb://localhost:27017

MONGO_DB=gromotion

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
